# Application Environment Configuration
# Copy this file to .env and update values for your local environment
# DO NOT commit .env file to version control

# APPLICATION SETTINGS

# Environment: dev, staging, prod
ENV=dev

# Log level - hierarchical filtering (each level shows itself + higher severity):
#   DEBUG - Shows everything (DEBUG + INFO + WARN + ERROR) - use for debugging
#   INFO  - Shows INFO + WARN + ERROR - recommended for development
#   WARN  - Shows WARN + ERROR - recommended for production
#   ERROR - Shows ERROR only - minimal logging
LOG_LEVEL=INFO

# SERVER SETTINGS

# HTTP server bind address (format: host:port or :port)
# Examples:
#   - localhost:8080  (local development)
#   - :8080           (all interfaces)
#   - 0.0.0.0:8080    (all interfaces, explicit)
HTTP_ADDRESS=localhost:8080

# STORAGE SETTINGS

# Path to storage/database file
STORAGE_PATH=storage/dev-storage.db

# CONFIGURATION FILE

# Path to YAML configuration file (optional)
# If not set, uses environment variables only
# CONFIG_PATH=config/dev.yaml
