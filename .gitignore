# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work
go.work.sum

# Build output
/bin/
/dist/
/build/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment variables
.env
.env.local
.env.*.local

# Application binary
/cmd/my-project/my-project
storage

# Config files (track *.example.yaml but ignore actual configs)
/config/*.yaml
!/config/*.example.yaml

# Debug files
__debug_bin
